{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nathanmcnulty/azd-device-cleanup/schemas/device-dynamic-group-proposal-fixture.schema.json",
  "title": "Device dynamic-group proposal fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "tenantId", "source", "devices"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "device-dynamic-group-proposal-fixture" },
    "tenantId": { "$ref": "#/definitions/guid" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "collectionState", "collectedAtUtc", "sha256", "records"],
      "properties": {
        "type": { "enum": ["IntuneManagedDevices", "DefenderMachines"] },
        "collectionState": { "enum": ["Complete", "Incomplete", "Unavailable", "NoData"] },
        "collectedAtUtc": { "type": "string", "format": "date-time" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "records": { "type": "array", "maxItems": 10000 }
      }
    },
    "devices": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entraObjectId", "deviceId"],
        "properties": {
          "entraObjectId": { "$ref": "#/definitions/guid" },
          "deviceId": { "$ref": "#/definitions/guid" },
          "existingAttribute": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "value", "owner", "observedAtUtc", "sourceSha256"],
            "properties": {
              "number": { "type": "integer", "minimum": 1, "maximum": 15 },
              "value": { "type": "string", "maxLength": 1024 },
              "owner": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
              "observedAtUtc": { "type": "string", "format": "date-time" },
              "sourceSha256": { "$ref": "#/definitions/sha256" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "properties": { "type": { "const": "IntuneManagedDevices" } } } } },
      "then": { "properties": { "source": { "properties": { "records": { "items": { "$ref": "#/definitions/intuneRecord" } } } } } }
    },
    {
      "if": { "properties": { "source": { "properties": { "type": { "const": "DefenderMachines" } } } } },
      "then": { "properties": { "source": { "properties": { "records": { "items": { "$ref": "#/definitions/defenderRecord" } } } } } }
    }
  ],
  "definitions": {
    "guid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "intuneRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "azureADDeviceId"],
      "properties": {
        "id": { "$ref": "#/definitions/guid" },
        "azureADDeviceId": { "$ref": "#/definitions/guid" }
      }
    },
    "defenderRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "aadDeviceId", "onboardingStatus", "lastSeen"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "aadDeviceId": { "$ref": "#/definitions/guid" },
        "onboardingStatus": { "enum": ["onboarded", "CanBeOnboarded", "Unsupported", "InsufficientInfo"] },
        "lastSeen": { "type": "string", "format": "date-time" }
      }
    }
  }
}
